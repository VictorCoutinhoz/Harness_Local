  "routes": [
    {
      "id": "escrita",
      "title": "Escrever e revisar",
      "uses": [
        "revisar-escrita",
        "caveman"
      ],
      "workflow": "Use revisar-escrita em todos os materiais. Ative Caveman quando o usuário pedir modo telegráfico.",
      "fallback": "Aplique as preferências de escrita do pedido."
    },
    {
      "id": "continuidade",
      "title": "Retomar ou registrar decisões",
      "uses": [
        "harness-local",
        "harness_local"
      ],
      "workflow": "Busque até cinco notas relevantes. Use o caminho Git comum em worktrees. Registre apenas decisões ou passagens concisas.",
      "fallback": "Use a consulta local ao mesmo banco quando o servidor MCP estiver indisponível."
    },
    {
      "id": "marca",
      "title": "Criar marca, nomes ou portfólio",
      "uses": [
        "brand-naming",
        "brand-architecture",
        "revisar-escrita",
        "ecc"
      ],
      "workflow": "Use naming para comparar nomes. Use arquitetura de marca para mapear marcas e linhas de produtos. Consulte ecc:brand-discovery para entrevistas de posicionamento quando a skill estiver disponível.",
      "fallback": "Reaproveite o briefing, os mercados e o público informados no pedido."
    },
    {
      "id": "planejar-design",
      "title": "Preparar briefing e navegação",
      "uses": [
        "design-brief",
        "information-architecture",
        "grill-me",
        "grilling"
      ],
      "workflow": "Use design-brief para o problema e os objetivos. Use information-architecture para hierarquia, navegação e fluxos. Reserve a entrevista em rodadas para quando solicitada.",
      "fallback": "Formalize as decisões já disponíveis e abra apenas as decisões essenciais que faltarem."
    },
    {
      "id": "interface",
      "title": "Criar ou revisar uma interface",
      "uses": [
        "frontend-design",
        "design-taste-frontend",
        "ui-ux-pro-max",
        "impeccable-review",
        "agent-browser"
      ],
      "workflow": "Escolha a direção visual pelo produto e preserve os tokens existentes. Examine a experiência renderizada antes de concluir a revisão.",
      "fallback": "Use os componentes e o navegador disponíveis no projeto."
    },
    {
      "id": "css",
      "title": "Localizar tokens no CSS",
      "uses": [
        "ast_grep",
        "frontend-design"
      ],
      "workflow": "Passe a regra runtime/css-tokens.yaml e a raiz absoluta do projeto ao ast-grep. Compare os valores com o seletor e o tema em que aparecem.",
      "fallback": "Leia as propriedades personalizadas e os tokens declarados nos arquivos CSS selecionados."
    },
    {
      "id": "codigo",
      "title": "Implementar, revisar e pesquisar código",
      "uses": [
        "ponytail",
        "source-driven-development",
        "ast_grep",
        "rtk",
        "ecc"
      ],
      "workflow": "Verifique a fonte oficial de APIs. Use ast-grep para padrões estruturais, RTK para consultas exploratórias resumidas e a skill ECC da stack quando relevante.",
      "fallback": "Use rg e o terminal original para evidência integral, edições e testes."
    },
    {
      "id": "legado",
      "title": "Documentar software legado e impacto",
      "uses": [
        "cartographer",
        "graphify",
        "ast_grep",
        "repowise",
        "ecc"
      ],
      "workflow": "Combine chamadas, mapa do projeto e testes. Quando o histórico Git mudar a análise, use RepoWise para o repositório selecionado.",
      "fallback": "Confirme o mapa com os pontos de entrada, os diffs e os testes existentes."
    },
    {
      "id": "testes-propriedades",
      "title": "Testar invariantes e transformações",
      "uses": [
        "property-based-testing",
        "ponytail"
      ],
      "workflow": "Formule propriedades verificáveis. Use a biblioteca adotada pelo projeto e preserve o menor contraexemplo útil.",
      "fallback": "Escreva exemplos de borda quando forem suficientes para o comportamento pedido."
    },
    {
      "id": "e2e",
      "title": "Planejar, criar ou reparar testes web",
      "uses": [
        "playwright-test",
        "playwright_test_planner",
        "playwright_test_generator",
        "playwright_test_healer",
        "agent-browser"
      ],
      "workflow": "Use a convenção do projeto. O Planner registra projeto, seed, cenário e caminho. O Generator percorre o cenário, salva o teste e registra o resultado. O Healer começa pela reprodução da falha e termina na reexecução.",
      "fallback": "Execute os testes do projeto e use um navegador disponível para verificar o fluxo."
    },
    {
      "id": "dados",
      "title": "Estruturar dados e análises reproduzíveis",
      "uses": [
        "jupyter-notebook",
        "docling",
        "property-based-testing",
        "ecc"
      ],
      "workflow": "Escolha notebook para análise reproduzível. Use Docling para tabelas, ordem de leitura ou OCR de arquivos autorizados. Consulte a skill ECC da stack de dados se disponível.",
      "fallback": "Use o leitor de documentos e as ferramentas da stack já instalados."
    },
    {
      "id": "estudos",
      "title": "Planejar redação e estudo de caso",
      "uses": [
        "redacao-e-estudo-de-caso",
        "revisar-escrita",
        "docling"
      ],
      "workflow": "Use a orientação da banca, a tarefa e o material disponibilizado. Selecione a estrutura de resposta que corresponda ao gênero pedido.",
      "fallback": "Leia o enunciado e as referências autorizadas antes de sugerir o esqueleto."
    },
    {
      "id": "gestao",
      "title": "Descobrir, revisar ou gerenciar skills",
      "uses": [
        "find-skills",
        "skillspector",
        "manage-skills",
        "skills-manager-cli"
      ],
      "workflow": "Confirme a origem e prepare a revisão exata. Analise a pasta com SkillSpector. Importe a cópia revisada só para a biblioteca e o destino solicitados.",
      "fallback": "Consulte o catálogo local e a origem da skill. Preserve as cópias existentes até resolver conflitos."
    },
    {
      "id": "claude",
      "title": "Auditar configuração ou sugerir automações do Claude Code",
      "uses": [
        "claude-settings-audit",
        "claude-automation-recommender"
      ],
      "workflow": "Use a auditoria para propor regras específicas do escopo pedido. Use a recomendação para selecionar automações justificadas pelo projeto.",
      "fallback": "Consulte a documentação oficial da versão instalada e entregue uma proposta."
    }
  ]
}
